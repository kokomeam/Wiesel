{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scripts/verify-agent-browser.ts",
    "scripts/verify-gallery-browser.ts",
    "scripts/verify-delete-browser.ts",
    "scripts/verify-coursepage-browser.ts",
    "scripts/verify-delete-structure-browser.ts",
    "scripts/verify-learn-browser.ts",
    "scripts/verify-list-browser.ts",
    "scripts/verify-marketing-sync-browser.ts",
    "scripts/verify-materialize-visual.ts",
    "scripts/screenshot-accounts.ts",
    "scripts/verify-ui-browser.ts",
    "scripts/screenshot-accounts-states.ts",
    "scripts/screenshot-publish-cards.ts",
    "scripts/e2e-inngest-live.ts",
    "scripts/e2e-inngest-cancel.ts",
    "scripts/e2e-agentic-publish.ts",
    "scripts/screenshot-publish-queue.ts",
    "scripts/verify-perf-browser.ts",
    "scripts/verify-portal-browser.ts",
    "scripts/verify-mastery-home-browser.ts",
    "scripts/verify-tutor-browser.ts",
    "scripts/verify-bundle-budgets.ts",
    "scripts/verify-lighthouse-budgets.ts"
  ]
}